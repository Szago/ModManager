<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ModManager</AssemblyName>
    <RootNamespace>ModManager</RootNamespace>
    <Version>2.3.9</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(ErosArtifactsDir)\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="updater\**\*.cs;tests\**\*.cs" />
    <ProjectReference Include="updater\ModManager.Updater.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="$(ErosArtifactsDir)\ModManager.Updater\$(Configuration)\ModManager.Updater.dll" LogicalName="ModManager.Updater.dll" />
    <EmbeddedResource Include="assets\*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ErosManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(ErosBepInExCoreDir)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ErosManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ErosManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ErosBepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ErosBepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ErosManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ErosManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ErosManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ErosManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ErosManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ErosManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateErosPaths" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ErosManagedDir)\Assembly-CSharp.dll')"
           Text="Game assemblies were not found at '$(ErosManagedDir)'. Update config\Local.props." />
    <Error Condition="!Exists('$(ErosBepInExCoreDir)\BepInEx.dll')"
           Text="BepInEx was not found at '$(ErosBepInExCoreDir)'. Update config\Local.props." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <MakeDir Directories="$(ErosPluginsDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ErosPluginsDir)" />
  </Target>
</Project>

